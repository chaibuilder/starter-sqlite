# Copy this file to `.env` for local development.
#
# When deploying to a host like Vercel you do not need to fill this in by hand:
# deploy the project first, then open `/setup` on the deployed site. The wizard
# generates these values for you to paste into your host's settings.

# --- Required ---

# Where your content is stored: a PostgreSQL connection string. Hosted providers
# give you one ready to paste; keep the `?sslmode=require` they put on the end.
# The database needs the PostGIS extension — most providers offer it in their
# dashboard, or run `CREATE EXTENSION postgis;` once.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chaibuilder

# Signs login sessions. Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=

# Identifies your site in the database. `/setup` prints this after creating your
# site; the CLI writes it for you when you scaffold locally.
CHAIBUILDER_APP_KEY=

# --- Recommended ---

# Your site's public address, used for sitemap and share links. On Vercel this
# falls back to the deployment URL when unset.
# NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Media storage ---
# Without these, uploaded images are written to local disk and are lost on every
# deploy. Works with Amazon S3, Cloudflare R2 and other S3-compatible storage.
# BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_ENDPOINT=

# --- AI (optional) ---
# Enables AI-assisted content editing. Set one of these, not both.
# A Vercel AI Gateway key (Vercel dashboard -> AI Gateway):
# AI_GATEWAY_API_KEY=
# ...or an OpenRouter key from https://openrouter.ai
# OPENROUTER_API_KEY=

# --- Stock photo search (optional) ---
# PEXELS_API_KEY=
# UNSPLASH_ACCESS_KEY=

# --- Email (optional) ---
# Needed for password reset emails.
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=

# --- Advanced ---
# Serve the admin panel from a custom path instead of /admin.
# PAYLOAD_ADMIN_ROUTE=

# Development only: create database tables from the schema instead of running
# migrations. Never enable this against a production database.
# PAYLOAD_DB_PUSH=true

# Integration tests only: the database `pnpm test:int` creates and wipes. Must
# never point at the database above — the test setup drops its schema.
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/chai_test
