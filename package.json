{
  "name": "chaibuilder",
  "version": "1.0.0",
  "description": "ChaiBuilder — visual site builder for Next.js with Payload CMS",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/generate-chaistyles.mjs && cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "node scripts/generate-chaistyles.mjs && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && node scripts/generate-chaistyles.mjs && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:chaistyles": "node scripts/generate-chaistyles.mjs",
    "generate:importmap": "cross-env NODE_OPTIONS=\"--no-deprecation\" payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=\"--no-deprecation\" payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=\"--no-deprecation\" payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@next/third-parties": "16.4.4",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "@payloadcms/db-sqlite": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "chaipro": "0.4.4",
    "cnfast": "^0.0.8",
    "cross-env": "10.1.0",
    "dotenv": "16.4.7",
    "drizzle-orm": "0.45.4",
    "geist": "1.9.0",
    "glob": "^13.0.6",
    "graphql": "^16.8.1",
    "lexical": "0.50.0",
    "next": "16.4.4",
    "payload": "3.90.2",
    "penpal": "^7.0.6",
    "react": "19.3.1",
    "react-diff-view": "^3.3.3",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.34.2",
    "styled-components": "6.6.0",
    "tailwindcss": "4.3.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.3.4",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/react": "16.3.3",
    "@types/escape-html": "^1.0.2",
    "@types/glob": "^9.0.0",
    "@types/lodash": "4.17.27",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "^9.2.5",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.4",
    "jsdom": "30.1.3",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.72.1",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": "^9 || ^10 || ^11"
  }
}